// SINH TỰ ĐỘNG từ database đã chạy okr360.sql — không sửa tay.
// Script: src/database/tools/generate-dbml.py · Xem sơ đồ: dán vào https://dbdiagram.io
Project okr360 {
  database_type: 'PostgreSQL'
  Note: 'OKR360 — quản lý OKR và đánh giá 360 độ. Schema okr360. Trigger, view và hàm nằm trong okr360.sql.'
}

Enum user_role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

Enum cycle_status {
  DRAFT
  ACTIVE
  CLOSED
}

Enum okr_level {
  COMPANY
  DEPARTMENT
  TEAM
  INDIVIDUAL
}

Enum org_unit_type {
  DEPARTMENT
  TEAM
}

Enum kr_type {
  NUMBER
  PERCENT
  BOOLEAN
}

Enum confidence_level {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

Enum weight_mode {
  AUTO
  MANUAL
}

Enum campaign_status {
  DRAFT
  NOMINATION
  COLLECTING
  CLOSED
  PUBLISHED
}

Enum reviewer_group {
  SELF
  MANAGER
  PEER
  DIRECT_REPORT
}

Enum assignment_status {
  NOT_STARTED
  DRAFT
  SUBMITTED
  CANCELLED
}

Enum nomination_status {
  DRAFT
  PENDING
  APPROVED
}

Enum result_grade {
  EXCELLENT
  GOOD
  MEETS
  NEEDS_IMPROVEMENT
  INSUFFICIENT_DATA
}

Enum notification_type {
  CHECKIN_REMINDER
  CHECKIN_OFF_TRACK
  CHECKIN_COMMENT
  PLANNING_REMINDER
  NOMINATION_REMINDER
  NOMINATION_PENDING
  REVIEW_REMINDER
  RESULT_PUBLISHED
  BLOCKER_ROUTED
  BLOCKER_UPDATED
  WEEKLY_DIGEST
  CHECKIN_MISMATCH
  AI_DRAFT_READY
  ONE_ON_ONE_SENT
  AUTOMATION_ALERT
}

Enum audit_action {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
  STATUS_CHANGE
  CHECKIN
  SUBMIT
  PUBLISH
  LOGIN
  LOGIN_FAILED
  EXPORT
}

Enum automation_flow {
  BLOCKER_ROUTING
  WEEKLY_DIGEST
  ONE_ON_ONE_DRAFT
  CHECKIN_MISMATCH
  OKR_REVIEW
  REVIEW_COMMENT_GUARD
}

Enum trigger_kind {
  EVENT
  SCHEDULE
  ON_SUBMIT
}

Enum domain_event_type {
  CHECKIN_CREATED
  OBJECTIVE_CREATED
  CAMPAIGN_CLOSED
}

Enum run_status {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

Enum blocker_category {
  DEPENDENCY
  RESOURCE
  TECHNICAL
  PRIORITY_CHANGE
  OTHER
}

Enum severity_level {
  LOW
  MEDIUM
  HIGH
}

Enum routing_status {
  OPEN
  ACKNOWLEDGED
  REJECTED
}

Enum review_issue {
  NOT_MEASURABLE
  OUTPUT_ONLY
  DUPLICATE
  NOT_ALIGNED
}

Enum draft_status {
  PENDING_REVIEW
  SENT
  DISCARDED
}

Table departments {
  id bigint [pk, increment]
  name varchar(150) [not null]
  parent_id bigint
  unit_type org_unit_type [not null, default: 'DEPARTMENT']
  head_user_id bigint
  is_active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Cây đơn vị tổ chức: phòng ban và team (unit_type). Team nằm ngay dưới một phòng ban, không có đơn vị con. head_user_id là trưởng phòng hoặc team lead.'
}

Table app_users {
  id bigint [pk, increment]
  email varchar(255) [not null]
  password_hash text [not null]
  full_name varchar(150) [not null]
  job_title varchar(150)
  phone varchar(30)
  avatar_url text
  role user_role [not null, default: 'EMPLOYEE']
  department_id bigint [not null]
  manager_id bigint
  is_active boolean [not null, default: `true`]
  failed_login_count smallint [not null, default: `0`]
  locked_until timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Người dùng. Mỗi người một vai trò và tối đa một quản lý trực tiếp; trigger chặn vòng lặp báo cáo.'
}

Table okr_cycles {
  id bigint [pk, increment]
  name varchar(50) [not null]
  start_date date [not null]
  end_date date [not null]
  planning_deadline date [not null]
  status cycle_status [not null, default: 'DRAFT']
  max_objectives_per_user smallint [not null, default: `5`]
  okr_weight numeric(3,2) [not null, default: `0.60`]
  weight_locked_at timestamptz
  activated_at timestamptz
  closed_at timestamptz
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    name [unique]
  }

  Note: 'Chu kỳ OKR theo quý. Chỉ một chu kỳ ACTIVE; trạng thái chỉ đi tiến; tỷ trọng OKR/360 khóa khi đợt 360 thu phiếu.'
}

Table objectives {
  id bigint [pk, increment]
  cycle_id bigint [not null]
  level okr_level [not null]
  title varchar(200) [not null]
  description text
  owner_user_id bigint [not null]
  department_id bigint
  parent_id bigint
  weight_mode weight_mode [not null, default: 'AUTO']
  weight_in_parent numeric(5,2)
  progress numeric(5,4) [not null, default: `0`]
  final_progress numeric(5,4)
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'Objective 4 cấp (công ty, phòng ban, team, cá nhân), nối thành cây bằng parent_id. progress là giá trị lưu đệm do tầng nghiệp vụ cộng dồn; final_progress chốt khi đóng chu kỳ.'
}

Table key_results {
  id bigint [pk, increment]
  objective_id bigint [not null]
  title varchar(200) [not null]
  kr_type kr_type [not null]
  start_value numeric(14,4) [not null, default: `0`]
  target_value numeric(14,4) [not null]
  unit varchar(30)
  assignee_user_id bigint [not null]
  weight numeric(5,2)
  sort_order smallint [not null, default: `0`]
  current_value numeric(14,4)
  current_confidence confidence_level
  last_checkin_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: '1–5 KR mỗi Objective. current_value / current_confidence lưu đệm từ check-in mới nhất.'
}

Table checkins {
  id bigint [pk, increment]
  key_result_id bigint [not null]
  value numeric(14,4) [not null]
  confidence confidence_level [not null]
  note text
  blocker text
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bản ghi bất biến: không sửa, không xóa. Chỉ người phụ trách KR, chỉ khi chu kỳ ACTIVE.'
}

Table checkin_comments {
  id bigint [pk, increment]
  checkin_id bigint [not null]
  author_user_id bigint [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bình luận của quản lý trực tiếp trên một lần check-in.'
}

Table review_templates {
  id bigint [pk, increment]
  name varchar(150) [not null]
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Mẫu phiếu 360. Khóa khi đã có đợt khác DRAFT sử dụng.'
}

Table review_criteria {
  id bigint [pk, increment]
  template_id bigint [not null]
  name varchar(150) [not null]
  description text
  is_required boolean [not null, default: `true`]
  sort_order smallint [not null, default: `0`]

  Note: 'Tiêu chí chấm điểm 1–5 của mẫu phiếu.'
}

Table review_questions {
  id bigint [pk, increment]
  template_id bigint [not null]
  question_text varchar(300) [not null]
  sort_order smallint [not null, default: `0`]

  Note: 'Câu hỏi mở của mẫu phiếu.'
}

Table review_campaigns {
  id bigint [pk, increment]
  cycle_id bigint [not null]
  template_id bigint [not null]
  name varchar(150) [not null]
  nomination_deadline date [not null]
  submit_deadline date [not null]
  min_peers smallint [not null, default: `3`]
  max_peers smallint [not null, default: `5`]
  anonymity_threshold smallint [not null, default: `3`]
  status campaign_status [not null, default: 'DRAFT']
  nomination_opened_at timestamptz
  collection_opened_at timestamptz
  closed_at timestamptz
  published_at timestamptz
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    cycle_id [unique]
  }

  Note: 'Đợt đánh giá 360, tối đa một đợt mỗi chu kỳ. DRAFT → NOMINATION → COLLECTING → CLOSED → PUBLISHED.'
}

Table campaign_participants {
  campaign_id bigint
  reviewee_user_id bigint
  manager_user_id bigint
  department_id bigint
  snapshot_at timestamptz

  Indexes {
    (campaign_id, reviewee_user_id) [pk]
  }

  Note: 'Người được đánh giá, kèm bản chụp quản lý trực tiếp và phòng ban khi mở thu phiếu.'
}

Table nominations {
  id bigint [pk, increment]
  campaign_id bigint [not null]
  reviewee_user_id bigint [not null]
  status nomination_status [not null, default: 'DRAFT']
  submitted_at timestamptz
  approved_by bigint
  approved_at timestamptz

  Indexes {
    (campaign_id, reviewee_user_id) [unique]
  }

  Note: 'Danh sách đồng nghiệp một người đề cử, chờ quản lý duyệt.'
}

Table nomination_peers {
  nomination_id bigint
  peer_user_id bigint
  added_by bigint [not null]

  Indexes {
    (nomination_id, peer_user_id) [pk]
  }

  Note: 'Từng đồng nghiệp trong danh sách đề cử.'
}

Table review_assignments {
  id bigint [pk, increment]
  campaign_id bigint [not null]
  reviewee_user_id bigint [not null]
  reviewer_user_id bigint [not null]
  reviewer_group reviewer_group [not null]
  status assignment_status [not null, default: 'NOT_STARTED']
  submitted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (campaign_id, reviewee_user_id, reviewer_user_id) [unique]
  }

  Note: 'Ai phải chấm ai và đã nộp chưa. KHÔNG chứa điểm.'
}

Table review_answers {
  id bigint [pk, increment]
  campaign_id bigint [not null]
  reviewee_user_id bigint [not null]
  reviewer_group reviewer_group [not null]
  assignment_id bigint
  response_key uuid [not null]
  criterion_id bigint
  question_id bigint
  score smallint
  answer_text text

  Note: 'Điểm và nhận xét. assignment_id bị đặt NULL khi đóng đợt nên database không còn biết ai chấm điểm nào.'
}

Table final_results {
  id bigint [pk, increment]
  cycle_id bigint [not null]
  user_id bigint [not null]
  okr_progress numeric(5,4)
  okr_score numeric(4,2)
  review_score numeric(4,2)
  final_score numeric(4,2)
  grade result_grade [not null]
  computed_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  Indexes {
    (cycle_id, user_id) [unique]
  }

  Note: 'Kết quả cuối kỳ: điểm OKR, điểm 360, điểm cuối kỳ theo tỷ trọng của chu kỳ.'
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type notification_type [not null]
  body varchar(500) [not null]
  link varchar(300)
  dedupe_key varchar(200) [not null]
  email_sent_at timestamptz
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, dedupe_key) [unique]
  }

  Note: 'Thông báo trong ứng dụng và email. dedupe_key chống gửi trùng.'
}

Table audit_logs {
  id bigint [pk, increment]
  actor_user_id bigint
  action audit_action [not null]
  module varchar(50) [not null]
  entity_type varchar(50)
  entity_id bigint
  summary varchar(500)
  metadata jsonb [not null, default: '{}']
  ip_address inet
  created_at timestamptz [not null, default: `now()`]

  Note: 'Nhật ký chỉ thêm mới. Không chứa mật khẩu, token, nội dung phiếu hay cặp người chấm ẩn danh.'
}

Table automation_flows {
  flow automation_flow [pk]
  name varchar(100) [not null]
  description varchar(300) [not null]
  trigger_kind trigger_kind [not null]
  schedule_cron varchar(50)
  is_enabled boolean [not null, default: `true`]
  daily_quota integer [not null, default: `500`]
  updated_by bigint
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Cấu hình 6 luồng AI dựng sẵn: bật/tắt, lịch chạy, hạn mức gọi AI mỗi ngày.'
}

Table domain_events {
  id bigint [pk, increment]
  event_type domain_event_type [not null]
  entity_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  Note: 'Hộp thư sự kiện (outbox) do trigger ghi cùng transaction với thao tác gốc. Chỉ có id đối tượng, không chép nội dung.'
}

Table automation_runs {
  id bigint [pk, increment]
  flow automation_flow [not null]
  event_id bigint
  run_key varchar(150) [not null]
  status run_status [not null, default: 'PENDING']
  attempt_count smallint [not null, default: `0`]
  next_attempt_at timestamptz
  started_at timestamptz
  finished_at timestamptz
  input_tokens integer
  output_tokens integer
  error_message varchar(500)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (flow, run_key) [unique]
  }

  Note: 'Lịch sử chạy. UNIQUE (flow, run_key) chống chạy trùng. Không lưu nội dung gửi cho AI hay AI trả về.'
}

Table automation_daily_usage {
  flow automation_flow
  usage_date date
  call_count integer [not null, default: `0`]

  Indexes {
    (flow, usage_date) [pk]
  }

  Note: 'Số lần gọi AI mỗi luồng mỗi ngày để áp hạn mức. Luồng cảnh báo nhận xét 360 chỉ được ghi ở đây.'
}

Table checkin_insights {
  checkin_id bigint [pk]
  blocker_run_id bigint
  blocker_category blocker_category
  severity severity_level
  target_department_id bigint
  mismatch_run_id bigint
  is_mismatch boolean
  routing routing_status
  handled_by bigint
  handled_at timestamptz
  handler_note varchar(300)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Nhãn AI trên check-in: phân loại vướng mắc, phòng ban liên quan, check-in không khớp; trạng thái xử lý của trưởng phòng nhận việc.'
}

Table objective_review_notes {
  id bigint [pk, increment]
  objective_id bigint [not null]
  key_result_id bigint
  run_id bigint [not null]
  issue review_issue [not null]
  message varchar(300) [not null]
  dismissed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Ghi chú rà soát OKR mới tạo. Người tạo tự quyết định sửa hay bỏ qua.'
}

Table weekly_digests {
  id bigint [pk, increment]
  manager_user_id bigint [not null]
  week_start date [not null]
  run_id bigint [not null]
  stats jsonb [not null]
  highlights jsonb [not null, default: '[]']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (manager_user_id, week_start) [unique]
  }

  Note: 'Bản tin tuần: stats tính từ database, highlights (tối đa 3) do AI viết.'
}

Table one_on_one_drafts {
  id bigint [pk, increment]
  campaign_id bigint [not null]
  reviewee_user_id bigint [not null]
  reviewer_user_id bigint
  run_id bigint [not null]
  ai_strengths jsonb [not null]
  ai_improvements jsonb [not null]
  edited_text text
  status draft_status [not null, default: 'PENDING_REVIEW']
  sent_by bigint
  sent_at timestamptz
  discarded_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (campaign_id, reviewee_user_id) [unique]
  }

  Note: 'Bản nháp 1-1: đề xuất gốc của AI không đổi; người duyệt sửa edited_text rồi gửi, chỉ sau khi đợt đã công bố.'
}

Ref: departments.parent_id > departments.id
Ref: departments.head_user_id > app_users.id
Ref: app_users.department_id > departments.id
Ref: app_users.manager_id > app_users.id
Ref: okr_cycles.created_by > app_users.id
Ref: objectives.cycle_id > okr_cycles.id
Ref: objectives.owner_user_id > app_users.id
Ref: objectives.department_id > departments.id
Ref: objectives.parent_id > objectives.id
Ref: objectives.created_by > app_users.id
Ref: objectives.deleted_by > app_users.id
Ref: key_results.objective_id > objectives.id
Ref: key_results.assignee_user_id > app_users.id
Ref: checkins.key_result_id > key_results.id
Ref: checkins.created_by > app_users.id
Ref: checkin_comments.checkin_id > checkins.id
Ref: checkin_comments.author_user_id > app_users.id
Ref: review_templates.created_by > app_users.id
Ref: review_criteria.template_id > review_templates.id
Ref: review_questions.template_id > review_templates.id
Ref: review_campaigns.cycle_id > okr_cycles.id
Ref: review_campaigns.template_id > review_templates.id
Ref: review_campaigns.created_by > app_users.id
Ref: campaign_participants.campaign_id > review_campaigns.id
Ref: campaign_participants.reviewee_user_id > app_users.id
Ref: campaign_participants.manager_user_id > app_users.id
Ref: campaign_participants.department_id > departments.id
Ref: nominations.approved_by > app_users.id
Ref: nominations.campaign_id > campaign_participants.campaign_id
Ref: nominations.reviewee_user_id > campaign_participants.reviewee_user_id
Ref: nomination_peers.nomination_id > nominations.id
Ref: nomination_peers.peer_user_id > app_users.id
Ref: nomination_peers.added_by > app_users.id
Ref: review_assignments.reviewer_user_id > app_users.id
Ref: review_assignments.campaign_id > campaign_participants.campaign_id
Ref: review_assignments.reviewee_user_id > campaign_participants.reviewee_user_id
Ref: review_answers.campaign_id > review_campaigns.id
Ref: review_answers.reviewee_user_id > app_users.id
Ref: review_answers.assignment_id > review_assignments.id
Ref: review_answers.criterion_id > review_criteria.id
Ref: review_answers.question_id > review_questions.id
Ref: final_results.cycle_id > okr_cycles.id
Ref: final_results.user_id > app_users.id
Ref: notifications.user_id > app_users.id
Ref: audit_logs.actor_user_id > app_users.id
Ref: automation_flows.updated_by > app_users.id
Ref: automation_runs.flow > automation_flows.flow
Ref: automation_runs.event_id > domain_events.id
Ref: automation_daily_usage.flow > automation_flows.flow
Ref: checkin_insights.checkin_id > checkins.id
Ref: checkin_insights.blocker_run_id > automation_runs.id
Ref: checkin_insights.target_department_id > departments.id
Ref: checkin_insights.mismatch_run_id > automation_runs.id
Ref: checkin_insights.handled_by > app_users.id
Ref: objective_review_notes.objective_id > objectives.id
Ref: objective_review_notes.key_result_id > key_results.id
Ref: objective_review_notes.run_id > automation_runs.id
Ref: weekly_digests.manager_user_id > app_users.id
Ref: weekly_digests.run_id > automation_runs.id
Ref: one_on_one_drafts.reviewer_user_id > app_users.id
Ref: one_on_one_drafts.run_id > automation_runs.id
Ref: one_on_one_drafts.sent_by > app_users.id
Ref: one_on_one_drafts.campaign_id > campaign_participants.campaign_id
Ref: one_on_one_drafts.reviewee_user_id > campaign_participants.reviewee_user_id
